# Supabase (or any Postgres) connection string.
# Use the "Transaction" pooler URL for DATABASE_URL and the direct connection for DIRECT_URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/apidirectory?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/apidirectory?schema=public"

# HTTP Basic Auth credentials gating /admin (the contribution review queue).
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Public base URL used for canonical links, sitemap.xml, and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret checked against the "Authorization: Bearer <secret>" header on the
# staleness-check cron endpoint. Vercel Cron sends this automatically when
# CRON_SECRET is set as a project env var; other schedulers must set it
# themselves.
CRON_SECRET="change-me"

# NextAuth session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional: "owner/repo" — shows a live GitHub star count in the footer CTA.
# Leave unset to show a generic "Open source" callout with no link instead
# of a fabricated repo URL.
GITHUB_REPO=""
